{
  "name": "genshin_trpg",
  "version": "0.0.2",
  "description": "genshin_trpg_v0.02：本地跑团与 DSH AI GM 工具，共用持久化规则运行时",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "trpg",
    "dice",
    "genshin"
  ],
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "engine",
    "data",
    "web",
    "server",
    "scripts",
    "bin",
    "prompt",
    "cordis.patch.yml",
    "README.md",
    "DESIGN.md"
  ],
  "scripts": {
    "test": "node scripts/test.mjs",
    "start": "node server/index.js",
    "doctor": "node scripts/doctor.mjs",
    "dsh:check": "node scripts/check-dsh.mjs",
    "usage:report": "node scripts/usage-report.mjs",
    "context:bench": "node scripts/context-benchmark.mjs",
    "characters:build": "node scripts/build-characters.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neko461/genshin_trpg.git",
    "directory": "code/dsh-trpg"
  },
  "homepage": "https://github.com/neko461/genshin_trpg",
  "bugs": {
    "url": "https://github.com/neko461/genshin_trpg/issues"
  }
}
